# Xerox Hotspot Upload - Environment Configuration

# Server binding
APP_HOST=0.0.0.0
APP_PORT=5000

# File storage directories
STORAGE_DIR=./incoming_files
ARCHIVE_DIR=./archived_files
DB_PATH=./jobs.db

# Upload limits
MAX_FILE_MB=30

# Optional passphrase to allow uploads (leave empty to disable)
UPLOAD_PASSPHRASE=

# Disk space threshold - stop accepting uploads if free space below this (MB)
DISK_LOW_THRESHOLD_MB=1024

# How long to keep archived files (days)
RETENTION_DAYS=7

# Rate limiting
RATE_LIMIT_PER_IP_PER_HOUR=10
RATE_LIMIT_CONCURRENT=2

# Logging directory
LOG_DIR=./logs

# ============== Razorpay Payment Gateway ==============
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============== Email Notifications (Optional) ==============
# SMTP settings for sending payment confirmations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ============== Authentication ==============
# JWT token signing key (REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_NAME=XeroxUploads

# Admin Dashboard (REQUIRED — change these from defaults!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ============== Supabase (REQUIRED - PostgreSQL + Storage) ==============
# This app uses Supabase for database and file storage.
# Get these from your Supabase project: Settings > API
# Database URL: Settings > Database > Connection String > URI
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_STORAGE_BUCKET=uploads
